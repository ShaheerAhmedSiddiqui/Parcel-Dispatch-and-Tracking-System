
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | ParcelTrack</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/forms.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>

<body class="dashboard-body">

    <%- include('../partials/dashboard-header') %>
    <%- include('../partials/admin-sidebar') %>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <main class="dashboard-main">
        <div class="dashboard-content">

            <section class="page-heading register-heading">
                <div>
                    <h1>Register New Parcel</h1>
                    <p>Enter shipment information to create a new parcel registration.</p>
                </div>

                <a href="/parcels" class="btn btn-outline">
                    Back to Parcels
                </a>
            </section>

            <% if (errorMessage) { %>
                <div class="form-alert form-alert-error" role="alert">
                    <strong>Registration failed:</strong>
                    <%= errorMessage %>
                </div>
            <% } %>

            <form
                id="registerParcelForm"
                class="register-form"
                action="/parcels"
                method="POST"
                novalidate
            >

                <!-- Sender information -->
                <section class="form-section">
                    <div class="form-section-heading">
                        <div class="form-section-icon">01</div>
                        <div>
                            <h2>Sender Information</h2>
                            <p>Provide the details of the person sending the parcel.</p>
                        </div>
                    </div>

                    <div class="form-grid">
                        <div class="form-field">
                            <label for="senderName">Sender Full Name <span>*</span></label>
                            <input
                                type="text"
                                id="senderName"
                                name="senderName"
                                placeholder="Enter sender's full name"
                                value="<%= formData.senderName || '' %>"
                                maxlength="100"
                                required
                            >
                        </div>

                        <div class="form-field">
                            <label for="senderContact">Sender Contact Number <span>*</span></label>
                            <input
                                type="tel"
                                id="senderContact"
                                name="senderContact"
                                placeholder="e.g. 03001234567"
                                value="<%= formData.senderContact || '' %>"
                                maxlength="20"
                                required
                            >
                        </div>

                        <div class="form-field form-field-full">
                            <label for="pickupAddress">Pickup Address <span>*</span></label>
                            <textarea
                                id="pickupAddress"
                                name="pickupAddress"
                                rows="3"
                                placeholder="Enter complete pickup address"
                                maxlength="500"
                                required
                            ><%= formData.pickupAddress || '' %></textarea>
                        </div>
                    </div>
                </section>

                <!-- Receiver information -->
                <section class="form-section">
                    <div class="form-section-heading">
                        <div class="form-section-icon">02</div>
                        <div>
                            <h2>Receiver Information</h2>
                            <p>Provide the details of the person receiving the parcel.</p>
                        </div>
                    </div>

                    <div class="form-grid">
                        <div class="form-field">
                            <label for="receiverName">Receiver Full Name <span>*</span></label>
                            <input
                                type="text"
                                id="receiverName"
                                name="receiverName"
                                placeholder="Enter receiver's full name"
                                value="<%= formData.receiverName || '' %>"
                                maxlength="100"
                                required
                            >
                        </div>

                        <div class="form-field">
                            <label for="receiverContact">Receiver Contact Number <span>*</span></label>
                            <input
                                type="tel"
                                id="receiverContact"
                                name="receiverContact"
                                placeholder="e.g. 03001234567"
                                value="<%= formData.receiverContact || '' %>"
                                maxlength="20"
                                required
                            >
                        </div>

                        <div class="form-field form-field-full">
                            <label for="deliveryAddress">Delivery Address <span>*</span></label>
                            <textarea
                                id="deliveryAddress"
                                name="deliveryAddress"
                                rows="3"
                                placeholder="Enter complete delivery address"
                                maxlength="500"
                                required
                            ><%= formData.deliveryAddress || '' %></textarea>
                        </div>
                    </div>
                </section>

                <!-- Parcel information -->
                <section class="form-section">
                    <div class="form-section-heading">
                        <div class="form-section-icon">03</div>
                        <div>
                            <h2>Parcel Information</h2>
                            <p>Specify the parcel weight and delivery service.</p>
                        </div>
                    </div>

                    <div class="form-grid">
                        <div class="form-field">
                            <label for="weight">Parcel Weight (kg) <span>*</span></label>
                            <input
                                type="number"
                                id="weight"
                                name="weight"
                                placeholder="e.g. 2.5"
                                min="0.01"
                                step="0.01"
                                value="<%= formData.weight || '' %>"
                                required
                            >
                        </div>

                        <div class="form-field">
                            <label for="deliveryType">Delivery Type <span>*</span></label>
                            <select id="deliveryType" name="deliveryType" required>
                                <option value="">Select delivery type</option>

                                <% deliveryTypes.forEach(type => { %>
                                    <option
                                        value="<%= type %>"
                                        <%= formData.deliveryType === type ? 'selected' : '' %>
                                    >
                                        <%= type.replace('_', ' ') %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="form-field">
                            <label for="distance">Distance (km)</label>
                            <input
                                type="number"
                                id="distance"
                                name="distance"
                                placeholder="Enter distance in kilometres"
                                min="0"
                                step="0.1"
                                value="<%= formData.distance ?? '' %>"
                            >
                            <small>Optional. If left empty, the system uses 0 km.</small>
                        </div>
                    </div>
                </section>

                <!-- Delivery charge -->
                <section class="charge-section">
                    <div class="charge-information">
                        <div class="charge-icon">Rs.</div>
                        <div>
                            <h2>Delivery Charge Estimate</h2>
                            <p>Calculate the estimated charge using the configured pricing rules.</p>
                        </div>
                    </div>

                    <div class="charge-result" id="chargeResult" aria-live="polite">
                        <span class="charge-placeholder">Not calculated yet</span>
                    </div>

                    <div class="charge-message" id="chargeMessage" role="status"></div>

                    <button
                        type="button"
                        class="btn btn-outline quote-button"
                        id="calculateQuoteButton"
                    >
                        Calculate Delivery Charge
                    </button>

                    <p class="charge-note">
                        The final delivery charge is calculated and verified by the server when the parcel is registered.
                    </p>
                </section>

                <!-- Form actions -->
                <div class="form-actions">
                    <a href="/parcels" class="btn btn-cancel">Cancel</a>

                    <button
                        type="submit"
                        class="btn btn-primary"
                        id="registerParcelButton"
                    >
                        Register Parcel
                    </button>
                </div>

            </form>

        </div>
    </main>

    <script src="/js/dashboard.js"></script>
    <script src="/js/register-parcel.js"></script>
</body>
</html>
