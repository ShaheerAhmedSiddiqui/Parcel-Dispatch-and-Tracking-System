<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= title || 'Error' %> | ParcelTrack
    </title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/public.css">

    <style>
        .error-page {
            min-height: 75vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 50px 20px;
            background: #f8f8f8;
        }

        .error-content {
            max-width: 550px;
            width: 100%;
            text-align: center;
            padding: 45px 30px;
            background: #fff;
            border: 1px solid #eee;
            border-radius: 12px;
            box-shadow: 0 5px 25px rgba(0, 0, 0, .04);
        }

        .error-code {
            font-size: 76px;
            line-height: 1;
            font-weight: 800;
            color: #ff6e49;
            margin-bottom: 20px;
        }

        .error-content h1 {
            font-size: 27px;
            color: #171717;
            margin-bottom: 12px;
        }

        .error-content p {
            color: #777;
            line-height: 1.7;
            font-size: 15px;
            margin-bottom: 28px;
        }

        .error-actions {
            display: flex;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .error-button {
            display: inline-block;
            padding: 13px 22px;
            background: #ff6e49;
            color: #fff;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
            font-size: 14px;
        }

        .error-button:hover {
            background: #e85d3b;
        }

        .error-secondary {
            background: #171717;
        }

        .error-secondary:hover {
            background: #333;
        }

        @media (max-width: 500px) {
            .error-content {
                padding: 35px 20px;
            }

            .error-code {
                font-size: 62px;
            }

            .error-content h1 {
                font-size: 23px;
            }

            .error-actions {
                flex-direction: column;
            }

            .error-button {
                width: 100%;
                box-sizing: border-box;
            }
        }
    </style>
</head>

<body>

    <%- include('partials/public-header', { activePage: '' }) %>

        <main class="error-page">

            <section class="error-content">

                <div class="error-code">
                    <%= status || 500 %>
                </div>

                <% if (status===404) { %>

                    <h1>Page Not Found</h1>

                    <p>
                        Sorry, the page you're looking for does not exist
                        or may have been moved.
                    </p>

                    <% } else if (status>= 500) { %>

                        <h1>Something Went Wrong</h1>

                        <p>
                            We're sorry, but an unexpected error occurred.
                            Please try again later.
                        </p>

                        <% } else { %>

                            <h1>Unable to Complete Your Request</h1>

                            <p>
                                <%= message || 'Something went wrong. Please try again.' %>
                            </p>

                            <% } %>

                                <div class="error-actions">

                                    <a href="/" class="error-button">
                                        Back to Home
                                    </a>

                                    <a href="/track" class="error-button error-secondary">
                                        Track a Parcel
                                    </a>

                                </div>

            </section>

        </main>

        <%- include('partials/footer') %>

</body>

</html>