
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | ParcelTrack</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .login-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            background: #f7f7f7;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            padding: 36px;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 8px 30px rgba(0,0,0,.07);
        }

        .login-card h1 {
            margin-bottom: 8px;
            font-size: 28px;
        }

        .login-subtitle {
            color: #777;
            margin-bottom: 28px;
        }

        .login-field {
            margin-bottom: 20px;
        }

        .login-field label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .login-field input {
            width: 100%;
            padding: 13px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 15px;
            box-sizing: border-box;
        }

        .login-button {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 8px;
            background: #ff6e49;
            color: white;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
        }

        .login-error {
            padding: 12px;
            margin-bottom: 20px;
            border-radius: 8px;
            background: #fff0ed;
            color: #b42318;
        }

        .login-back {
            display: block;
            margin-top: 22px;
            text-align: center;
            color: #555;
            text-decoration: none;
        }
    </style>
</head>

<body>

    <main class="login-page">
        <section class="login-card">

            <h1>Welcome Back</h1>
            <p class="login-subtitle">
                Sign in to your ParcelTrack staff account.
            </p>

            <% if (errorMessage) { %>
                <div class="login-error" role="alert">
                    <%= errorMessage %>
                </div>
            <% } %>

            <form action="/login" method="POST">

                <div class="login-field">
                    <label for="email">Email Address</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="Enter your email"
                        autocomplete="username"
                        required
                    >
                </div>

                <div class="login-field">
                    <label for="password">Password</label>
                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Enter your password"
                        autocomplete="current-password"
                        required
                    >
                </div>

                <button type="submit" class="login-button">
                    Sign In
                </button>

            </form>

            <a href="/" class="login-back">
                ← Back to Home
            </a>

        </section>
    </main>

</body>
</html>
