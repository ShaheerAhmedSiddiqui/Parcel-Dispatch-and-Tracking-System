
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title %> | ParcelTrack</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/public.css">

    <style>
        .tracking-page {
            min-height: 75vh;
            padding: 55px 20px;
            background: #f8f8f8;
        }

        .tracking-container {
            max-width: 850px;
            margin: auto;
        }

        .tracking-heading {
            text-align: center;
            margin-bottom: 32px;
        }

        .tracking-heading h1 {
            font-size: 32px;
            margin-bottom: 10px;
        }

        .tracking-heading p {
            color: #777;
        }

        .tracking-search {
            display: flex;
            gap: 12px;
            padding: 18px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,.05);
            margin-bottom: 28px;
        }

        .tracking-search input {
            flex: 1;
            min-width: 0;
            padding: 14px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 15px;
        }

        .tracking-search button {
            padding: 14px 24px;
            border: none;
            border-radius: 8px;
            background: #ff6e49;
            color: white;
            font-weight: 600;
            cursor: pointer;
        }

        .tracking-error {
            padding: 15px;
            margin-bottom: 25px;
            background: #fff0ed;
            color: #b42318;
            border-radius: 8px;
        }

        .tracking-result {
            padding: 28px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,.05);
        }

        .tracking-result h2 {
            font-size: 21px;
            margin-bottom: 8px;
        }

        .tracking-number {
            color: #777;
            margin-bottom: 22px;
        }

        .current-status {
            padding: 18px;
            background: #fff4ef;
            border-radius: 9px;
            margin-bottom: 30px;
        }

        .current-status small {
            display: block;
            color: #777;
            margin-bottom: 7px;
        }

        .current-status strong {
            color: #e65d39;
            font-size: 20px;
        }

        .tracking-timeline {
            margin-top: 25px;
        }

        .tracking-timeline h3 {
            margin-bottom: 24px;
        }

        .timeline-item {
            position: relative;
            padding: 0 0 25px 32px;
            border-left: 2px solid #e5e5e5;
            margin-left: 8px;
        }

        .timeline-item:last-child {
            border-left-color: transparent;
        }

        .timeline-dot {
            position: absolute;
            left: -9px;
            top: 0;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: #ccc;
            border: 3px solid white;
            box-shadow: 0 0 0 1px #ccc;
        }

        .timeline-item.latest .timeline-dot {
            background: #ff6e49;
            box-shadow: 0 0 0 1px #ff6e49;
        }

        .timeline-item strong {
            display: block;
            margin-bottom: 6px;
        }

        .timeline-item time {
            font-size: 13px;
            color: #888;
        }

        .tracking-footer-info {
            margin-top: 25px;
            color: #888;
            font-size: 13px;
        }

        @media (max-width: 550px) {
            .tracking-search {
                flex-direction: column;
            }

            .tracking-search button {
                width: 100%;
            }

            .tracking-result {
                padding: 20px;
            }

            .tracking-heading h1 {
                font-size: 26px;
            }
        }
    </style>
</head>

<body>

    <header style="background:#fff;padding:18px 6%;border-bottom:1px solid #eee;">
        <a href="/" style="font-size:22px;font-weight:700;color:#171717;text-decoration:none;">
            Parcel<span style="color:#ff6e49;">Track</span>
        </a>

        <a href="/login" style="float:right;color:#555;text-decoration:none;">
            Staff Login
        </a>
    </header>

    <main class="tracking-page">

        <div class="tracking-container">

            <div class="tracking-heading">
                <h1>Track Your Parcel</h1>
                <p>Enter your tracking number to see the latest shipment updates.</p>
            </div>

            <form action="/track" method="GET" class="tracking-search">

                <input
                    type="text"
                    name="trackingNumber"
                    placeholder="Enter tracking number (e.g. PT-000001)"
                    value="<%= trackingNumber %>"
                    maxlength="25"
                    required
                >

                <button type="submit">
                    Track Parcel
                </button>

            </form>

            <% if (errorMessage) { %>

                <div class="tracking-error" role="alert">
                    <%= errorMessage %>
                </div>

            <% } %>

            <% if (parcel) { %>

                <section class="tracking-result">

                    <h2>Shipment Details</h2>

                    <p class="tracking-number">
                        Tracking Number: <strong><%= parcel.trackingNumber %></strong>
                    </p>

                    <div class="current-status">

                        <small>Current Shipment Status</small>

                        <strong><%= parcel.currentStatus %></strong>

                    </div>

                    <div class="tracking-timeline">

                        <h3>Shipment History</h3>

                        <% if (shipmentHistory.length > 0) { %>

                            <% shipmentHistory.forEach((record, index) => { %>

                                <div class="timeline-item <%= index === shipmentHistory.length - 1 ? 'latest' : '' %>">

                                    <span class="timeline-dot"></span>

                                    <strong><%= record.status %></strong>

                                    <time>
                                        <%= new Date(record.updatedAt).toLocaleString() %>
                                    </time>

                                </div>

                            <% }) %>

                        <% } else { %>

                            <p>No shipment history is available.</p>

                        <% } %>

                    </div>

                    <p class="tracking-footer-info">
                        Shipment history is displayed in chronological order.
                    </p>

                </section>

            <% } %>

        </div>

    </main>

</body>
</html>
